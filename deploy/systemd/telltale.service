# TelltaleDNS native service (REQ: OPS-004, spec/08 §4). Installed by deploy/systemd/install.sh.
[Unit]
Description=TelltaleDNS resolver
Documentation=https://github.com/paimonsoror/telltaledns/blob/main/docs/running.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=telltale
Group=telltale
ExecStart=/usr/local/bin/telltale run -c /etc/telltale/telltale.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
# Graceful drain (OPS-007) gets time to finish.
TimeoutStopSec=30
Environment=TELLTALE_LOG=info
# REQ: OPS-004 (ADR-046) — how this node updates (self-update).
Environment=TELLTALE_INSTALL=native

# Port 53 without root: only this capability, nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Sandboxing: everything read-only except the data directory.
StateDirectory=telltale
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Netlink is needed for the neighbor table (MAC addresses).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0027

# A Pi-sized ceiling; raise it for very large blocklists.
MemoryMax=256M
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
