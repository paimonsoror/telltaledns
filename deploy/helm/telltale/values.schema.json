{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "TelltaleDNS chart values",
  "type": "object",
  "properties": {
    "mode": {
      "description": "allInOne (one StatefulSet) or scaled (a controller StatefulSet plus resolver pods that join it, CLU-009). daemonSet comes later.",
      "enum": [
        "allInOne",
        "scaled"
      ]
    },
    "hostNetwork": {
      "type": "boolean"
    },
    "dnsPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "config": {
      "type": "string"
    },
    "encrypted": {
      "type": "object",
      "properties": {
        "dot": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "doh": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "http3": {
              "type": "boolean"
            }
          }
        },
        "proxyProtocol": {
          "type": "boolean"
        },
        "tls": {
          "type": "object",
          "properties": {
            "secretName": {
              "type": "string"
            },
            "certManager": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "issuerRef": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "Issuer",
                        "ClusterIssuer"
                      ]
                    }
                  }
                },
                "dnsNames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "doq": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "dns": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "LoadBalancer",
                "NodePort",
                "ClusterIP"
              ]
            },
            "externalTrafficPolicy": {
              "enum": [
                "Local",
                "Cluster"
              ]
            },
            "port": {
              "type": "integer"
            },
            "clusterIP": {
              "description": "REQ: FLT-017 \u2014 a fixed cluster address for the DNS Service (the kubelet's cluster DNS).",
              "type": "string"
            }
          }
        },
        "api": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "LoadBalancer",
                "NodePort",
                "ClusterIP"
              ]
            },
            "port": {
              "type": "integer"
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "existingClaim": {
          "type": "string"
        }
      }
    },
    "secretMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "secretName"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "secretName": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "advertise": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "bootstrapSecret": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rollout": {
          "type": "object",
          "properties": {
            "canaries": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "bakeSeconds": {
              "type": "integer",
              "minimum": 5
            },
            "servfailPct": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "requireTraffic": {
              "type": "boolean"
            },
            "history": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "resolvers": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "ephemeralTtlSeconds": {
          "type": "integer",
          "minimum": 60
        }
      }
    },
    "kubernetes": {
      "description": "REQ: FLT-017 \u2014 Kubernetes workloads as devices (the controller watches pods and namespaces, read-only).",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clusterDomain": {
          "type": "string",
          "minLength": 1
        },
        "clusterDns": {
          "description": "CoreDNS's Service address: kubectl -n kube-system get svc kube-dns -o jsonpath='{.spec.clusterIP}'",
          "type": "string"
        },
        "podCidr": {
          "type": "string",
          "pattern": "^$|^(\\d{1,3}\\.){3}\\d{1,3}/(8|16|24|[0-9]|[12][0-9]|3[0-2])$"
        },
        "serviceCidr": {
          "type": "string",
          "pattern": "^$|^(\\d{1,3}\\.){3}\\d{1,3}/(8|16|24|[0-9]|[12][0-9]|3[0-2])$"
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "excludeNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        },
        "defaultGroup": {
          "type": "string"
        },
        "map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "namespace",
              "group"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9*][-a-z0-9.*]*$"
              },
              "kind": {
                "enum": [
                  "",
                  "deploy",
                  "sts",
                  "ds",
                  "job",
                  "cronjob",
                  "rs",
                  "pod"
                ]
              },
              "name": {
                "type": "string"
              },
              "group": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "rbac": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "serviceAccountName": {
              "type": "string"
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "clusterDns": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}$|^[0-9a-fA-F:]+$"
          }
        },
        "required": [
          "clusterDns"
        ]
      }
    }
  }
}
