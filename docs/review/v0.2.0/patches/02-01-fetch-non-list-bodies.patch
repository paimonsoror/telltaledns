+/// Rejects a body that parses to no rules at all (while having invalid lines), or to more
+/// invalid lines than rules: a JSON error, a compressed blob, or an HTML page without the
+/// doctype prefix passes [`sanity_check`] and would otherwise replace a good list with
+/// nothing. REQ: FLT-004 — a list that fails keeps its last good version.
+fn usable_check(data: &[u8]) -> Result<(), String> {
+    use crate::parse::{ListOptions, parse_list};
+    let s = parse_list(data, ListOptions::default(), |_, _| {});
+    if (s.rules == 0 && s.invalid > 0) || s.invalid > s.rules {
+        let first = s
+            .samples
+            .iter()
+            .find(|x| !x.unsupported)
+            .map_or("", |x| x.reason.as_str());
+        return Err(format!(
+            "not a usable list: {} rules, {} invalid lines (first: {first})",
+            s.rules, s.invalid
+        ));
+    }
+    Ok(())
+}
