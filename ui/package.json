{
  "name": "telltale-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/i18n.mjs prebuild && vite",
    "build": "node scripts/i18n.mjs prebuild && vite build && node scripts/postbuild.mjs",
    "check": "node scripts/i18n.mjs prebuild && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "types": "openapi-typescript ../docs/api/openapi.json -o src/lib/api-types.ts",
    "check:help": "node scripts/check-help.mjs",
    "check:i18n": "node scripts/i18n.mjs check",
    "test:e2e": "node scripts/i18n.mjs prebuild && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "uplot": "^1.6.32"
  }
}
