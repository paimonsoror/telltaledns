{
  "name": "telltale-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "types": "openapi-typescript ../docs/api/openapi.json -o src/lib/api-types.ts",
    "check:help": "node scripts/check-help.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "uplot": "^1.6.32"
  }
}
